# Laravel settings for the wedding site's API (RSVP, invite links, /admin).
# Local: copy to .env, then run: php artisan key:generate
# Live site: fill in .env.production instead; the repository-level `npm run package` includes it as .env.
APP_NAME="EJ Wedding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The site's address. Live: https://yourdomain.com (also used for the Messenger/Facebook link preview).
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# MySQL database: XAMPP locally; on Hostinger hPanel -> Databases (names there start with a prefix like u123456789_).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache are files, so shared hosting needs no extra tables. Admin sessions last 7 days.
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Login for /admin. Use a strong password on the live site.
ADMIN_USERNAME=
ADMIN_PASSWORD=
