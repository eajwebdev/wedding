# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Login for /admin (the RSVP guest list). Use a strong password before sharing the site.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the admin login cookie. Any random string of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
