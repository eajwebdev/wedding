# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Login for /admin (the RSVP guest list). Use a strong password before sharing the site.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the admin login cookie. Any random string of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# MySQL database for RSVPs. On Hostinger: hPanel → Databases → Management → create one,
# then copy its database name, username and password here. The table is created automatically.
# DB_HOST is "localhost" for the app running on Hostinger; from your own PC use the
# hostname shown under Databases → Remote MySQL (after allowing your IP there).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# The site's public address, used for the Messenger/Facebook link preview picture.
# Locally http://localhost:3000; on Hostinger your domain, e.g. https://edwinandjochel.com
SITE_URL=http://localhost:3000
