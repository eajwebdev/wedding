# Live-site settings. Copy to .env.production (git-ignored), fill in, then run `npm run package` in the project root:
# it builds the site with APP_URL and ships this file to the server as laravel/.env.
APP_NAME="EJ Wedding"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Your domain, with https
APP_URL=https://yourdomain.com

LOG_CHANNEL=single
LOG_LEVEL=error

# From hPanel -> Databases -> Management (full names, including the u123456789_ prefix)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The live site runs on https (turn on SSL in hPanel), so the admin cookie is sent over https only
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Login for /admin: a strong password
ADMIN_USERNAME=
ADMIN_PASSWORD=
